# AgentKoin service: MAINNET env template (Base, eip155:8453). NO SECRETS IN THIS FILE.
# Testnet config is unchanged; this file is used only for a future mainnet service deploy.
# Requires the service from branch mainnet-service (commit 9eb5a4b), which adds AGENTCOIN_NETWORK=base.
AGENTCOIN_NETWORK=base
RPC_URL=https://mainnet.base.org

# Exchange buyer-fee recipient (off-chain fee leg). Carter, Nov 23: "Exchange fees go to the new fee Safe".
# REQUIRED on base: the service refuses to start if it is unset, malformed, or equal to the operator signer.
AGENTCOIN_EXCHANGE_FEE_RECIPIENT=<FEE_RECIPIENT_SAFE>
# Exchange buyer-fee terms (service defaults 80 bps / 50000 = 0.8%, min 0.05 USDC); set explicitly for mainnet.
# AGENTCOIN_EXCHANGE_FEE_BPS=80
# AGENTCOIN_EXCHANGE_FEE_MIN=50000

# Contract addresses: read from deployments/8453.json (written by script/DeployMainnet.s.sol); each can be
# overridden here. USDC is fixed to Circle USDC 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913 (checked).
# AGENTCOIN_ESCROW=<from deployments/8453.json>
# AGENTCOIN_REGISTRY=<from deployments/8453.json>
# AGENTCOIN_ROUTE_FACTORY=<from deployments/8453.json>
# AGENTCOIN_RECOVERY_VAULT=<from deployments/8453.json>
# AGENTCOIN_ARBITRATOR=<escrowArbitrator; 0x0 while disputes are off>
# AGENTCOIN_DEPLOY_BLOCK=<deployBlock>

# Keys come from the secret store at deploy time, never from this file. On base there is NO fallback to the
# testnet key files (.secrets/testnet-*.key): a missing key is a startup error.
# AGENTCOIN_OPERATOR_KEY, AGENTCOIN_RELAYER_KEY, AGENTCOIN_PROVIDER_KEY, AGENTCOIN_EVALUATOR_KEY, AGENTCOIN_DEPLOYER_KEY

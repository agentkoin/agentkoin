{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentcoin-trust/0.1",
  "title": "AgentCoin trust manifest v0.1",
  "description": "Operator-signed snapshot of contracts, parameters, evaluator stakes and attestations. Every field is re-checkable on chain (see agent/lib/verify.mjs).",
  "type": "object",
  "required": [
    "v",
    "issuer",
    "agent",
    "chainId",
    "network",
    "issuedAt",
    "snapshotBlock",
    "contracts",
    "fees",
    "escrowConfig",
    "registryConfig",
    "evaluators",
    "disputeRules",
    "audits",
    "attestations",
    "signature"
  ],
  "additionalProperties": false,
  "$defs": {
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "bytes32": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "uintString": {
      "type": "string",
      "pattern": "^[0-9]+$",
      "description": "unsigned integer as decimal string; token amounts in 6-decimal base units"
    },
    "contractRef": {
      "type": "object",
      "required": [
        "address",
        "codeHash"
      ],
      "properties": {
        "address": {
          "$ref": "#/$defs/address"
        },
        "codeHash": {
          "$ref": "#/$defs/bytes32",
          "description": "keccak256(eth_getCode(address)) at snapshotBlock"
        },
        "symbol": {
          "type": "string"
        },
        "decimals": {
          "type": "integer"
        },
        "kind": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "eip191Signature": {
      "type": "object",
      "required": [
        "scheme",
        "canonicalization",
        "digest",
        "signer",
        "value"
      ],
      "properties": {
        "scheme": {
          "const": "eip191"
        },
        "canonicalization": {
          "const": "RFC8785"
        },
        "digest": {
          "const": "keccak256"
        },
        "signer": {
          "$ref": "#/$defs/address"
        },
        "signedDigest": {
          "$ref": "#/$defs/bytes32",
          "description": "keccak256 of RFC 8785 JSON of the document without 'signature'"
        },
        "value": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{130}$"
        }
      },
      "additionalProperties": false
    },
    "attestation": {
      "type": "object",
      "required": [
        "v",
        "chainId",
        "type",
        "subject",
        "blockNumber",
        "claim",
        "signature"
      ],
      "properties": {
        "v": {
          "const": "agentcoin-attestation/0.1"
        },
        "chainId": {
          "type": "integer"
        },
        "type": {
          "enum": [
            "evaluator-stake",
            "contract-code"
          ]
        },
        "subject": {
          "$ref": "#/$defs/address"
        },
        "contract": {
          "$ref": "#/$defs/address"
        },
        "blockNumber": {
          "$ref": "#/$defs/uintString"
        },
        "claim": {
          "type": "object"
        },
        "signature": {
          "$ref": "#/$defs/eip191Signature"
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "v": {
      "const": "agentcoin-trust/0.1"
    },
    "issuer": {
      "$ref": "#/$defs/address",
      "description": "operator address; must equal signature.signer and own agent.agentId"
    },
    "agent": {
      "description": "ERC-8004 identity of the issuer, or null on networks without an identity registry (v0.3: Base Sepolia)",
      "anyOf": [
        {
          "type": "object",
          "required": [
            "agentRegistry",
            "agentId"
          ],
          "properties": {
            "agentRegistry": {
              "type": "string",
              "pattern": "^eip155:[0-9]+:0x[0-9a-fA-F]{40}$"
            },
            "agentId": {
              "$ref": "#/$defs/uintString"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "chainId": {
      "type": "integer"
    },
    "network": {
      "type": "string",
      "pattern": "^eip155:[0-9]+$"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "snapshotBlock": {
      "$ref": "#/$defs/uintString"
    },
    "contracts": {
      "type": "object",
      "required": [
        "escrow",
        "evaluatorRegistry",
        "token",
        "arbitrator"
      ],
      "properties": {
        "escrow": {
          "$ref": "#/$defs/contractRef"
        },
        "evaluatorRegistry": {
          "$ref": "#/$defs/contractRef"
        },
        "token": {
          "$ref": "#/$defs/contractRef"
        },
        "arbitrator": {
          "$ref": "#/$defs/contractRef"
        },
        "identityRegistry": {
          "$ref": "#/$defs/contractRef"
        },
        "treasury": {
          "$ref": "#/$defs/address"
        },
        "evaluatorAdapter": {
          "$ref": "#/$defs/contractRef"
        },
        "depositRouteFactory": {
          "$ref": "#/$defs/contractRef"
        }
      },
      "additionalProperties": false
    },
    "fees": {
      "type": "object",
      "required": [
        "feeBps",
        "chargedOn"
      ],
      "properties": {
        "feeBps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "chargedOn": {
          "type": "string"
        },
        "buyerBond": {
          "type": "string"
        },
        "evaluatorFeeBps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "evaluatorFeeChargedOn": {
          "type": "string"
        },
        "arbitrationFee": {
          "$ref": "#/$defs/uintString"
        },
        "arbitrationFeeModel": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "escrowConfig": {
      "type": "object",
      "required": [
        "version",
        "instantThreshold",
        "minChallengeBond",
        "evalWindow",
        "challengeWindow",
        "arbitrationTimeout",
        "challengeBondBps",
        "missedVerdictSlashBps",
        "wrongVerdictSlashBps",
        "materialDiffBps",
        "feeBps",
        "failedChallengeEvaluatorShareBps",
        "instantBondCoverBps",
        "evaluatorFeeBps"
      ],
      "properties": {
        "version": {
          "type": "integer"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/uintString"
      }
    },
    "registryConfig": {
      "type": "object",
      "required": [
        "minStake",
        "unbondingPeriod",
        "exposureMultiplier",
        "slashHarmedShareBps",
        "treasury"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "evaluators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "address",
          "active",
          "stake",
          "exposure",
          "availableExposure",
          "openJobs",
          "unbondingEndsAt",
          "slashedTotal",
          "snapshotBlock"
        ],
        "properties": {
          "address": {
            "$ref": "#/$defs/address"
          },
          "active": {
            "type": "boolean"
          },
          "stake": {
            "$ref": "#/$defs/uintString"
          },
          "exposure": {
            "$ref": "#/$defs/uintString"
          },
          "availableExposure": {
            "$ref": "#/$defs/uintString"
          },
          "openJobs": {
            "type": "integer"
          },
          "unbondingEndsAt": {
            "$ref": "#/$defs/uintString"
          },
          "slashedTotal": {
            "$ref": "#/$defs/uintString"
          },
          "snapshotBlock": {
            "$ref": "#/$defs/uintString"
          }
        },
        "additionalProperties": false
      }
    },
    "sla": {
      "type": "object",
      "properties": {
        "quoteP95Ms": {
          "type": [
            "integer",
            "null"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "disputeRules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "$ref": "#/$defs/bytes32"
          }
        },
        "additionalProperties": false
      }
    },
    "audits": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "attestations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attestation"
      }
    },
    "endpoints": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "signature": {
      "$ref": "#/$defs/eip191Signature"
    },
    "adapterConfig": {
      "type": "object",
      "required": [
        "version",
        "evalWindow",
        "challengeWindow",
        "arbitrationTimeout",
        "expiryMargin",
        "requiredExpiryDuration",
        "minChallengeBond",
        "challengeBondBps",
        "missedVerdictSlashBps",
        "wrongVerdictSlashBps",
        "failedChallengeEvaluatorShareBps",
        "completeThresholdBps"
      ],
      "properties": {
        "version": {
          "type": "integer"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/uintString"
      }
    },
    "testnet": {
      "type": "boolean",
      "description": "true on a public testnet deployment (factual label)"
    },
    "localDevnet": {
      "type": "boolean",
      "description": "true on a local Anvil devnet"
    },
    "realValue": {
      "type": "boolean",
      "description": "false: tokens settled here have no real-world value"
    }
  }
}

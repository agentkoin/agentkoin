          "evaluatorModel": {
            "registry": "0x30576DE005df028D1947C56dEcc85a2a5612036a",
            "minStake": "2000000",
            "verdict": "evaluator calls verdict(jobId, Complete|Reject|Partial, payoutBps, reasonHash) on a Submitted job",
            "evalWindowSeconds": 3600,
            "challenge": "client or provider may challenge a verdict within challengeWindowSeconds (600) with a bond plus arbitration fee; testnet arbitrator is MockArbitrator",
            "challengeWindowSeconds": 600
          },
          "payout": "after challengeWindowSeconds, finalize(jobId) pays provider amount * payoutBps / 10000 minus protocol and evaluator fees",
          "refunds": [
            {
              "condition": "job Funded, deadline reached, no deliverable submitted",
              "call": "claimRefund(jobId) or cancel(jobId)",
              "caller": "anyone (claimRefund); client (cancel)",
              "refund": "amount (100%)"
            },
            {
              "condition": "job Funded, provider has not accepted or submitted",
              "call": "cancel(jobId)",
              "caller": "client",
              "refund": "amount (100%)"
            },
            {
              "condition": "job Submitted, no verdict within evalWindowSeconds (3600)",
              "call": "timeoutRelease(jobId)",
              "caller": "anyone",
              "refund": "amount (100%); evaluator stake slashed"
            },
            {
              "condition": "verdict Reject (payoutBps 0) or Partial, challengeWindowSeconds (600) elapsed",
              "call": "finalize(jobId)",
              "caller": "anyone",
              "refund": "amount * (10000 - payoutBps) / 10000"
            }
          ],
          "instantRelease": "if amount <= instantThreshold and the provider bond covers amount * instantBondCoverBps, submit releases payment without a verdict; then only the client may challenge"
        }
      },

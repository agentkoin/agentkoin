    {
      "name": "open_job",
      "title": "Build escrow job transactions",
      "description": "Builds unsigned EIP-1559 transactions (USDC approve, then escrow createAndFund) for the given client, provider, evaluator, amount, deadline and spec. Nothing is signed or sent; the client signs and broadcasts. Returns calldata, nonces and the absolute deadline.",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "client": {
            "description": "address that signs and pays; required unless demoSign",
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "provider": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "evaluator": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "amount": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "description": "USDC base units (6 decimals), decimal string"
          },
          "deadlineSeconds": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "description": "seconds from the latest block until the submission deadline"
          },
          "specHash": {
            "description": "keccak256 of the job spec; required unless spec is given",
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{64}$"
          },
          "spec": {
            "description": "job spec text; hashed with keccak256 if specHash is absent",
            "type": "string",
            "maxLength": 10000
          },
          "demoSign": {
            "description": "sign and send with the server key; accepted only when the server runs with AGENTCOIN_DEMO_SIGN=1 (local demo)",
            "type": "boolean"
          }
        },
        "required": [
          "provider",
          "evaluator",
          "amount",
          "deadlineSeconds"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "chainId": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "network": {
            "type": "string"
          },
          "networkName": {
            "type": "string"
          },
          "testnet": {
            "type": "boolean"
          },
          "localDevnet": {
            "type": "boolean"
          },
          "realValue": {
            "type": "boolean"
          },
          "blockNumber": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "description": "unsigned integer, decimal string"
          },
          "contracts": {
            "type": "object",
            "properties": {
              "escrow": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              },
              "evaluatorRegistry": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              },
              "token": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              },
              "arbitrator": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              },
              "identityRegistry": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{40}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "evaluatorAdapter": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              },
              "depositRouteFactory": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              }
            },
            "required": [
              "escrow",
              "evaluatorRegistry",
              "token",
              "arbitrator",
              "identityRegistry",
              "evaluatorAdapter",
              "depositRouteFactory"
            ],
            "additionalProperties": false
          },
          "mode": {
            "type": "string",
            "enum": [
              "unsigned",
              "demo-signed"
            ]
          },
          "client": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "provider": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "evaluator": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "amount": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "description": "USDC base units (6 decimals), decimal string"
          },
          "specHash": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{64}$"
          },
          "deadline": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "description": "absolute unix time encoded in the createAndFund calldata"
          },
          "transactions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "step": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "label": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "const": "eip1559"
                },
                "chainId": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "from": {
                  "type": "string",
                  "pattern": "^0x[0-9a-fA-F]{40}$"
                },
                "to": {
                  "type": "string",
                  "pattern": "^0x[0-9a-fA-F]{40}$"
                },
                "data": {
                  "type": "string",
                  "pattern": "^0x[0-9a-fA-F]*$"
                },
                "value": {
                  "type": "string",
                  "pattern": "^[0-9]+$",
                  "description": "unsigned integer, decimal string"
                },
                "nonce": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "gas": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9]+$",
                      "description": "unsigned integer, decimal string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "estimate; null when it depends on a prior step"
                },
                "maxFeePerGas": {
                  "type": "string",
                  "pattern": "^[0-9]+$",
                  "description": "unsigned integer, decimal string"
                },
                "maxPriorityFeePerGas": {
                  "type": "string",
                  "pattern": "^[0-9]+$",
                  "description": "unsigned integer, decimal string"
                }
              },
              "required": [
                "step",
                "label",
                "type",
                "chainId",
                "from",
                "to",
                "data",
                "value",
                "nonce",
                "gas",
                "maxFeePerGas",
                "maxPriorityFeePerGas"
              ],
              "additionalProperties": false
            }
          },
          "expectedJobId": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "description": "jobCount+1 at build time; differs if another job is created first"
          },
          "jobId": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "description": "unsigned integer, decimal string"
          },
          "state": {
            "type": "string"
          },
          "txHashes": {
            "type": "object",
            "properties": {
              "approve": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{64}$"
              },
              "createAndFund": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{64}$"
              }
            },
            "required": [
              "approve",
              "createAndFund"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "chainId",
          "network",
          "blockNumber",
          "contracts",
          "mode",
          "client",
          "provider",
          "evaluator",
          "amount",
          "specHash",
          "deadline",
          "transactions",
          "expectedJobId"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false
      }
    },
